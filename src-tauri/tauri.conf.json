{
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8054/index.html"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": [
      "ffmpeg.exe",
      "ffprobe.exe",
      "ffplay.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "productName": "典典直播切片",
  "version": "../package.json",
  "identifier": "cn.vjoi.bilishadowreplay",
  "plugins": {
    "sql": {
      "preload": ["sqlite:data_v2.db"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["bsr"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQ0NEOTYzQTNGOTc2N0MKUldSOGR2bWpZOW5Nb1RlYjMvdmhkeWVjbFM0YkxNdnJUT2RBRWJzTm13cGRxaHNJYzdQcmhtSTkK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "scope": ["**"],
        "enable": true
      },
      "csp": null
    }
  }
}
