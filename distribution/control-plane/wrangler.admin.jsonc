{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diandian-admin-api",
  "main": "src/admin-worker.ts",
  "compatibility_date": "2026-09-11",
  "vars": {
    "GITHUB_RELEASES_REPOSITORY": "25-svg/diandian-releases",
    "UPDATE_API_BASE_URL": "https://diandian-update-api.xuxu-jarvis-home.workers.dev"
  },
  "assets": {
    "directory": ".wrangler/admin-assets",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "diandian-control", "database_id": "b4e4bb5e-aeeb-4ee0-be0e-82c860d6cbe0", "migrations_dir": "migrations" }]
}
