{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diandian-admin-api",
  "main": "src/admin-worker.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".wrangler/admin-assets",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "diandian-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "diandian-artifacts" }]
}
