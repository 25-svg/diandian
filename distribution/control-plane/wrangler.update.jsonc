{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diandian-update-api",
  "main": "src/update-worker.ts",
  "compatibility_date": "2026-09-11",
  "d1_databases": [{ "binding": "DB", "database_name": "diandian-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "diandian-artifacts" }]
}
